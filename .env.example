# این فایل را به .env کپی کن و کلیدهای «جدید» را بگذار. .env را هرگز commit نکن (chmod 600 .env).
# چند کلید را با کاما جدا کن.

# کلیدهای رایگان (فقط برای پلن‌های رایگان و به‌عنوان پشتیبان پلن‌های پولی)
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
GEMINI_API_KEYS=

# کلیدهای پولی (اولویت اول پلن‌های basic/pro/team)
GROQ_PAID_API_KEYS=
OPENROUTER_PAID_API_KEYS=
CEREBRAS_PAID_API_KEYS=
GEMINI_PAID_API_KEYS=

# ───── ذخیره‌سازی (هر دو لوکال روی همین سیستم) ─────
# PostgreSQL: مرجع نهایی کاربران، اعتبار و لاگ مصرف. اگر خالی بماند SQLite استفاده می‌شود.
#   قبلش بساز:  createdb ai_gateway
DATABASE_URL=
# Redis: rate limit، شمارنده‌ها، موجودی، کش و سلامت کلیدها. خالی = حافظه‌ی همین پروسه.
REDIS_URL=

# توکن ادمین: یک رشته‌ی طولانی و تصادفی
#   python -c "import secrets;print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=

SITE_NAME=My AI
SITE_URL=https://example.com
# اگر پشت Nginx/Caddy هستی true بگذار تا آی‌پی واقعی کاربر از X-Forwarded-For خوانده شود
TRUST_PROXY=false

# هویت برند (به‌عنوان system prompt به همه‌ی مکالمه‌ها اضافه می‌شود)
BRAND_PROMPT=You are My AI, a helpful assistant. Reply in the same language the user writes in.

DEFAULT_MODEL=my-ai
DEFAULT_PLAN=free

# صف انتظار وقتی همه‌ی کلیدها موقتاً محدود شده‌اند
QUEUE_WAIT=8
MAX_QUEUE=200
# کش پاسخ برای درخواست‌های temperature=0 (ثانیه؛ ۰ = خاموش)
CACHE_TTL=3600
# circuit breaker: بعد از این تعداد خطای پشت‌سرهم، مسیر موقتاً قطع می‌شود
BREAKER_THRESHOLD=3
# هشدار وقتی یک کاربر در یک ساعت از بیش از این تعداد آی‌پی استفاده کند
ANOMALY_IPS=8

# هشدار (اختیاری): ربات تلگرام و/یا وب‌هوک
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
